      "feature_a": {"type": "cylinder", "axis": "y", "center": [-20.0, 38.0], "radius": 2.25, "y_range": [-0.5, 5.5]},
      "feature_b": {"type": "cylinder", "axis": "y", "center": [20.0, 38.0], "radius": 2.25, "y_range": [-0.5, 5.5]},
