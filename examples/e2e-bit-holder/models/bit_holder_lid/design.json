{
  "schema": "design-spec.v1",
  "model": "bit_holder_lid",
  "units": "mm",
  "intent": "Screw-on lid for the 20-slot driver-bit holder body. Internal sinusoidal 3-start thread engages the body's external thread for twist-to-close operation.",
  "features": [
    {
      "id": "outer_lid",
      "intent": "Round 70 mm diameter x 18 mm tall cap with closed top and diamond knurl on outer surface.",
      "checks": ["lid_bbox", "watertight", "lid_outer_diameter", "top_component_count"]
    },
    {
      "id": "threaded_inner_interface",
      "intent": "Internal sinusoidal 3-start thread and recess for screw-on engagement with body.",
      "checks": [
        "recess_inner_diameter",
        "recess_component_count",
        "thread_inner_radius_metadata",
        "thread_clearance_metadata"
      ]
    }
  ],
  "checks": [
    {
      "id": "lid_bbox",
      "type": "bbox_size",
      "expected": [66.0, 66.0, 18.0],
      "tolerance": 1.0
    },
    {
      "id": "watertight",
      "type": "watertight",
      "expected": true
    },
    {
      "id": "lid_outer_diameter",
      "type": "outer_diameter_at_z",
      "z": 9.0,
      "center": [0.0, 0.0],
      "expected": 66.0,
      "tolerance": 0.8
    },
    {
      "id": "recess_inner_diameter",
      "type": "inner_diameter_at_z",
      "z": 5.0,
      "center": [0.0, 0.0],
      "expected": 60.4,
      "tolerance": 1.0
    },
    {
      "id": "recess_component_count",
      "type": "section_component_count",
      "axis": "z",
      "z": 5.0,
      "expected": 2,
      "tolerance": 0
    },
    {
      "id": "top_component_count",
      "type": "section_component_count",
      "axis": "z",
      "z": 16.0,
      "expected": 1,
      "tolerance": 0
    },
    {
      "id": "thread_inner_radius_metadata",
      "type": "metadata_equals",
      "path": "fit.thread_inner_radius_mm",
      "expected": 30.2
    },
    {
      "id": "thread_clearance_metadata",
      "type": "metadata_equals",
      "path": "fit.diametral_clearance_mm",
      "expected": 0.4
    },
    {
      "id": "step_artifact",
      "type": "artifact_exists",
      "path": "outputs/bit_holder_lid.step"
    },
    {
      "id": "stl_artifact",
      "type": "artifact_exists",
      "path": "outputs/bit_holder_lid.stl"
    }
  ]
}
