{
  "schema": "design-spec.v1",
  "model": "bracket",
  "units": "mm",
  "intent": "NEMA17 L-bracket: base plate mounts to panel (4 M3 bolts), vertical web holds NEMA17 motor, rounded base edges, side nut trap, cable slot, triangular gussets.",
  "features": [
    {
      "id": "base_plate",
      "intent": "Horizontal mounting plate that attaches to panel via 4 M3 bolts.",
      "checks": ["base_solid_z2.5", "watertight", "volume_range"]
    },
    {
      "id": "vertical_web",
      "intent": "Vertical plate at back edge for NEMA17 motor mounting.",
      "checks": ["web_solid_z26", "web_base_connected"]
    },
    {
      "id": "nema_mount",
      "intent": "NEMA17 motor mounting pattern: center bore (22mm) and 4 M3 clearance screw holes (31mm spacing).",
      "checks": ["nema_bore_dia", "nema_screw_ll", "nema_screw_lr", "nema_screw_ul", "nema_screw_ur", "nema_bore_access", "nema_screw_ll_access", "nema_screw_lr_access", "nema_screw_ul_access", "nema_screw_ur_access", "nema_bore_left_wall", "nema_bore_top_wall", "nema_screw_ll_left_wall"]
    },
    {
      "id": "panel_mount",
      "intent": "4 M3 clearance holes in rectangular pattern for mounting bracket to panel.",
      "checks": ["panel_hole_fl", "panel_hole_fr", "panel_hole_bl", "panel_hole_br", "panel_access_fl", "panel_access_fr", "panel_access_bl", "panel_access_br", "panel_fl_front_wall", "panel_bl_back_wall"]
    },
    {
      "id": "base_rounding",
      "intent": "3mm fillet on base plate bottom edges (front and sides, not back near web).",
      "checks": ["base_round_corner_void"]
    },
    {
      "id": "nut_trap",
      "intent": "M3 hex nut pocket on web outer face (Y-axis approach) for side fastening.",
      "checks": ["nut_trap_void", "nut_trap_access"]
    },
    {
      "id": "cable_slot",
      "intent": "Cable routing channel on web outer face, vertical extent near motor.",
      "checks": ["cable_slot_void"]
    },
    {
      "id": "gusset",
      "intent": "Two triangular gussets reinforcing the base-web junction.",
      "checks": ["gusset_solid_z8", "gusset_root_connected"]
    }
  ],
  "checks": [
